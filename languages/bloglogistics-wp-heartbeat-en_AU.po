msgid "WP Heartbeat Settings"
msgstr "WP Heartbeat Settings"

msgid "WP Heartbeat"
msgstr "WP Heartbeat"

msgid "BlogLogistics"
msgstr "BlogLogistics"

msgid "Use the submenu links to configure installed BlogLogistics plugins."
msgstr "Use the submenu links to configure installed BlogLogistics plugins."

msgid "This plugin controls the WordPress Heartbeat API in three common areas: the Dashboard, the post editor, and the frontend."
msgstr "This plugin controls the WordPress Heartbeat API in three common areas: the Dashboard, the post editor, and the frontend."

msgid "Disabling Heartbeat can reduce background admin-ajax.php requests, but it can also affect autosave, post locking, editor presence, and collaboration features. Keep the post editor enabled unless you have a clear reason to disable it."
msgstr "Disabling Heartbeat can reduce background admin-ajax.php requests, but it can also affect autosave, post locking, editor presence, and collaboration features. Keep the post editor enabled unless you have a clear reason to disable it."

msgid "Heartbeat controls"
msgstr "Heartbeat controls"

msgid "Set an interval in seconds, or set the value to 0 to disable Heartbeat for that area. WordPress ignores very low Heartbeat values, so enabled intervals are enforced at a minimum of 15 seconds."
msgstr "Set an interval in seconds, or set the value to 0 to disable Heartbeat for that area. WordPress ignores very low Heartbeat values, so enabled intervals are enforced at a minimum of 15 seconds."

msgid "Disable"
msgstr "Disable"

msgid "Recommended default:"
msgstr "Recommended default:"

msgid "Dashboard: Disabled. Post editor: 60 seconds. Frontend: Disabled."
msgstr "Dashboard: Disabled. Post editor: 60 seconds. Frontend: Disabled."

msgid "Save Heartbeat Settings"
msgstr "Save Heartbeat Settings"

msgid "No changes to save."
msgstr "No changes to save."

msgid "Restore recommended defaults"
msgstr "Restore recommended defaults"

msgid "This disables Heartbeat on the Dashboard and frontend, and keeps the post editor Heartbeat at 60 seconds."
msgstr "This disables Heartbeat on the Dashboard and frontend, and keeps the post editor Heartbeat at 60 seconds."

msgid "Unsaved changes."
msgstr "Unsaved changes."

msgid "You do not have permission to manage these settings."
msgstr "You do not have permission to manage these settings."

msgid "Settings"
msgstr "Settings"

msgid "Dashboard Heartbeat"
msgstr "Dashboard Heartbeat"

msgid "Post Editor Heartbeat"
msgstr "Post Editor Heartbeat"

msgid "Frontend Heartbeat"
msgstr "Frontend Heartbeat"

msgid "Controls Heartbeat on the main WordPress Dashboard screen."
msgstr "Controls Heartbeat on the main WordPress Dashboard screen."

msgid "Controls Heartbeat in the post editor. Autosave and post locking rely on this, so 60 seconds is the recommended setting."
msgstr "Controls Heartbeat in the post editor. Autosave and post locking rely on this, so 60 seconds is the recommended setting."

msgid "Controls Heartbeat on public-facing pages when a theme or plugin enqueues it."
msgstr "Controls Heartbeat on public-facing pages when a theme or plugin enqueues it."

msgid "Heartbeat settings saved."
msgstr "Heartbeat settings saved."

msgid "Recommended defaults restored."
msgstr "Recommended defaults restored."

msgid "No changes were made."
msgstr "No changes were made."
